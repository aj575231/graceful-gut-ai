# Copy to .env and fill in real values. Never commit .env.
#
# APP_ENV selects the security posture. There are exactly two values:
#
#   production   secure and fail-closed. Used by EVERY AWS deployment,
#                whichever stage it represents. The X-GG-Key gate is enforced
#                and /openapi.json is hidden.
#   development  local development ONLY. Allows unauthenticated access when
#                GG_API_KEY is unset and exposes /openapi.json. Never set this
#                on a deployed function.
#
# Anything else -- including the retired value "dev" -- is treated as
# production. A missing APP_ENV also fails closed.
APP_ENV=development

# Shared secret for the X-GG-Key header, required on every route except
# /health. Generate your own with: openssl rand -hex 32
#
# Leave this blank here. Never commit a real value, and never paste one into a
# script, test, document, or deployment package.
#
# X-GG-Key is temporary internal-development protection only. It must NOT be
# embedded in the Squarespace browser client or any other browser-side code --
# anything shipped to a browser is readable by everyone. See CLAUDE.md.
GG_API_KEY=
