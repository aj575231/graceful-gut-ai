# Copy to .env and fill in real values. Never commit .env.
#
# APP_ENV selects the security posture. There are exactly two values:
#
#   production   secure and fail-closed. Used by EVERY AWS deployment,
#                whichever stage it represents. The X-GG-Key gate is enforced,
#                /openapi.json is hidden, and the shared secret is read from
#                AWS Secrets Manager.
#   development  local development ONLY. Reads the shared secret from
#                GG_API_KEY below, allows unauthenticated access when that is
#                unset, exposes /openapi.json, and never contacts AWS. Never
#                set this on a deployed function.
#
# Anything else -- including the retired value "dev" -- is treated as
# production. A missing APP_ENV also fails closed.
APP_ENV=development

# LOCAL DEVELOPMENT ONLY. Shared secret for the X-GG-Key header, required on
# every route except /health. Generate your own with: openssl rand -hex 32
#
# Production IGNORES this variable entirely -- it reads the secret from Secrets
# Manager instead (see GG_API_SECRET_ID). Setting it on a deployed function
# does nothing except leave a credential in plain text in the function
# configuration, so don't.
#
# Leave this blank here. Never commit a real value, and never paste one into a
# script, test, document, or deployment package.
#
# X-GG-Key is temporary internal-development protection only. It must NEVER be
# embedded in Squarespace JavaScript, any other browser-side or mobile code, an
# iframe configuration, a URL or query string, or any client-visible file --
# anything shipped to a browser is readable by every visitor. See CLAUDE.md.
GG_API_KEY=

# The Secrets Manager secret holding the shared secret, as a name or an ARN.
# Required by every posture except development; a production deployment with
# this unset returns 503 on every gated route.
#
# This is an IDENTIFIER, not a credential -- it is safe in deployment scripts,
# function configuration, and CI output. The value it points at is a JSON
# document with exactly one field:
#
#   {"api_key": "<the shared secret>"}
#
# Never put the secret value in this file, in .env, or anywhere else in the
# repository. An administrator sets it directly on the secret:
#
#   aws secretsmanager put-secret-value --secret-id <id> \
#     --secret-string '{"api_key":"<key>"}'
#
# Leave this blank for local development -- it is not read under APP_ENV=development.
GG_API_SECRET_ID=
