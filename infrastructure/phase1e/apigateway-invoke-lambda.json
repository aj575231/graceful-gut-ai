{
  "Version": "2012-10-17",
  "Id": "GracefulGutApiGatewayInvoke",
  "Statement": [
    {
      "Sid": "AllowThisApiToInvokeTheFunction",
      "Effect": "Allow",
      "Principal": {
        "Service": "apigateway.amazonaws.com"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-2:<AWS_ACCOUNT_ID>:function:graceful-gut-ai-dev-api",
      "Condition": {
        "ArnLike": {
          "AWS:SourceArn": "arn:aws:execute-api:us-east-2:<AWS_ACCOUNT_ID>:<API_ID>/*/*/*"
        }
      }
    }
  ]
}
