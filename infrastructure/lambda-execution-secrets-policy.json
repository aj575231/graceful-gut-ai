{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadGracefulGutApiKeySecret",
      "Effect": "Allow",
      "Resource": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:graceful-gut-ai/dev/api-key-*",
      "Action": [
        "secretsmanager:GetSecretValue"
      ]
    }
  ]
}
